# Self-hosted Brief. Copy to .env and fill in. SELF_HOSTING.md says where each value comes from.
# Required: Clerk, Supabase, OpenAI, CONNECTIONS_KEY, APP_URL. Everything else is optional.

# ── App ──────────────────────────────────────────────────────────────────
# The address people open. The extension must point at the same one
# (node extension/scripts/configure.mjs <APP_URL>).
APP_URL=http://localhost:3000

# ── Clerk: sign-in (clerk.com, free tier is enough) ──────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Supabase: Postgres + Storage (supabase.com, free tier is enough) ─────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Connect > Session pooler URI, with your database password. Used only by the migrate step.
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── OpenAI: transcription and ticket writing ─────────────────────────────
OPENAI_API_KEY=sk-...
# AGENT_MODEL=
# TRANSCRIBE_MODEL=

# ── Tracker token encryption ─────────────────────────────────────────────
# base64 of 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTIONS_KEY=

# ── Trackers: fill the ones your team uses (web/TRACKERS.md) ─────────────
# Each OAuth app's redirect URI is <APP_URL>/api/connect/<provider>/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
AZURE_DEVOPS_CLIENT_ID=
AZURE_DEVOPS_CLIENT_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
TRELLO_API_KEY=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=

# ── Extension ────────────────────────────────────────────────────────────
# Your unpacked extension's id (chrome://extensions). Optional: without it
# pairing takes one click instead of none.
NEXT_PUBLIC_EXTENSION_ID=

# ── Owner views (/admin) ─────────────────────────────────────────────────
# Comma-separated emails that may open the usage views. They show who filed
# how much, never ticket content (PRIVACY.md). Empty = nobody.
BRIEF_OWNER_EMAILS=

# ── Anonymous heartbeat (TELEMETRY.md) ───────────────────────────────────
# Once a day: a hashed instance id, version, and counts (people, briefs
# created/filed/failed this week, tracker kinds). Nothing else. off to stop.
BRIEF_TELEMETRY=on
