# Brief Cloud — local env. Copy to `.env.local` and fill in. (.env* is gitignored.)

# ── Clerk (login + profile + connections) ────────────────────────────────
# Clerk dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Supabase (Postgres + Storage only; no Supabase Auth) ─────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # service_role secret (server-only)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...  # only if a browser client is needed (likely not)

# ── Anthropic (the processing agent) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-4-6           # optional; default in code

# ── OpenAI (ticket-filing agent + audio transcription) ───────────────────
OPENAI_API_KEY=sk-...
# TRANSCRIBE_MODEL=gpt-4o-transcribe  # optional; default in code (gpt-4o-transcribe)

# ── App ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Tracker connections ──────────────────────────────────────────────────
# Linear, Jira and GitHub are Clerk connected accounts - enable each one in the
# Clerk dashboard and Clerk vends the token. Nothing to set here.
#
# GitHub additionally needs the `repo` scope, which Clerk's built-in connection
# cannot be configured to request. Brief asks for it at connect time via
# additionalScopes (lib/clerk-strategies.ts), so this works out of the box.
#
# Only set these to move a provider onto a CUSTOM Clerk connector, which is the
# escape hatch for a scope combination a built-in connection can't express.
# Custom connectors require a paid Clerk plan on production instances.
# NEXT_PUBLIC_GITHUB_CLERK_STRATEGY=oauth_custom_<slug>
# NEXT_PUBLIC_LINEAR_CLERK_STRATEGY=
# NEXT_PUBLIC_JIRA_CLERK_STRATEGY=
